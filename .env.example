# ===== Required（必填）=====
# 登录密码 / Dashboard login password
DASHBOARD_PASSWORD=
# Session 签名密钥，建议 >= 32 位随机字符串 / Session signing secret
SESSION_SECRET=

# ===== FX（汇率，可选；也可在界面修改）=====
USD_CNY_RATE=

# ===== Persistence（持久化）=====
# Turso / libSQL。不填则本地开发使用 data/store.json
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 界面保存的 CEX 密钥加密用（AES-256-GCM；64 hex 或任意口令）
ENCRYPTION_KEY=

# ===== Wallets（可选；也可只在界面管理）=====
# JSON 数组示例（请换成你自己的地址，勿提交真实地址到公开仓库）:
# SEED_WALLETS=[{"name":"Main","address":"0x0000000000000000000000000000000000000000","chain":"EVM"}]
SEED_WALLETS=
# 逗号分隔：暂停自动刷新的地址（仅展示缓存）
PAUSED_WALLET_ADDRESSES=

# ===== CEX（仅使用只读 API Key！）=====
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# 设为 1 走 OKX 模拟盘
OKX_SIMULATED=
BINANCE_API_KEY=
BINANCE_API_SECRET=
GATE_API_KEY=
GATE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# ===== On-chain / DeFi providers（全部可选）=====
# 币安 Web3 开发者门户：建议只勾 Market / Wallet / DeFi（只读），作 DeFi 仓位备用源
BN_WEB3_API_KEY=
BN_WEB3_API_SECRET=
# OKX Web3
OKX_WEB3_API_KEY=
OKX_WEB3_API_SECRET=
OKX_WEB3_PASSPHRASE=
# OKX OnchainOS
OKX_ONCHAINOS_API_KEY=
OKX_ONCHAINOS_API_SECRET=
OKX_ONCHAINOS_API_PASSPHRASE=
ALCHEMY_API_KEY=
ZERION_API_KEY=
# 额外 Zerion Key，逗号分隔
ZERION_API_KEYS=
COINSTATS_API_KEY=
DEBANK_ACCESS_KEY=

# ===== Scheduled refresh（定时刷新鉴权）=====
# GET|POST /api/cron/refresh?mode=auto
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# 例: https://your-dashboard.example.com
# 信任的 workflow 标识 JSON 数组（见 src/lib/cron-auth.ts）

# ===== Misc =====
# 本地 HTTP 调试时允许非 Secure Cookie
FORCE_INSECURE_COOKIES=
# 读取快照时做锯齿清洗（调试）
SANITIZE_ON_READ=

# Optional advanced (not needed for self-hosted VPS cron):
# GITHUB_OIDC_AUDIENCES=
# GITHUB_OIDC_TRUSTED_WORKFLOWS=
