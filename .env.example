# ===== Required =====
# Dashboard login password
DASHBOARD_PASSWORD=
# Session signing secret (>= 32 random chars)
SESSION_SECRET=

# Optional USD->CNY rate (also editable in UI)
USD_CNY_RATE=

# ===== Persistence =====
# Turso / libSQL (recommended for serverless). Without it, local dev uses data/store.json.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AES-256-GCM key for CEX credentials saved via UI (64 hex chars or any passphrase)
ENCRYPTION_KEY=

# ===== Wallets (optional; can also be managed in the UI) =====
# JSON array: [{"name":"Main","address":"0x0000000000000000000000000000000000000000","chain":"EVM"}]
SEED_WALLETS=
# Comma-separated addresses whose refresh is paused (display only)
PAUSED_WALLET_ADDRESSES=

# ===== CEX (read-only keys only!) =====
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_SIMULATED=
BINANCE_API_KEY=
BINANCE_API_SECRET=
GATE_API_KEY=
GATE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# ===== On-chain data providers (all optional) =====
# Binance Web3 Developer Portal key (DeFi/Wallet/Market read-only); backup DeFi position source
BN_WEB3_API_KEY=
BN_WEB3_API_SECRET=
# OKX Web3 / OnchainOS
OKX_WEB3_API_KEY=
OKX_WEB3_API_SECRET=
OKX_WEB3_PASSPHRASE=
OKX_ONCHAINOS_API_KEY=
OKX_ONCHAINOS_API_SECRET=
OKX_ONCHAINOS_API_PASSPHRASE=
ALCHEMY_API_KEY=
ZERION_API_KEY=
# Comma-separated extra Zerion keys
ZERION_API_KEYS=
COINSTATS_API_KEY=
DEBANK_ACCESS_KEY=

# ===== Scheduled refresh =====
# GET /api/cron/refresh?mode=auto with header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Optional GitHub Actions OIDC auth (see src/lib/cron-auth.ts)
# Comma-separated audiences, e.g. https://your-dashboard.example.com
GITHUB_OIDC_AUDIENCES=
# JSON array of trusted workflows
GITHUB_OIDC_TRUSTED_WORKFLOWS=

# Misc
FORCE_INSECURE_COOKIES=
SANITIZE_ON_READ=
